{
  "manifest_version": 3,
  "name": "Quirra",
  "version": "0.4.0",
  "description": "Know if your AI responses have been generated before.",
  "action": { "default_title": "Quirra" },
  "options_page": "options.html",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ],
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}

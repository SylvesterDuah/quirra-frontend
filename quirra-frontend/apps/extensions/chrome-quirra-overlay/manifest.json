{
  "manifest_version": 3,
  "name": "Quirra",
  "short_name": "Quirra",
  "version": "0.5.0",
  "description": "Instant AI prompt and response analysis — risk, duplicates, and style feedback as you type.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "keepalive.js"
  },
  "options_page": "options.html",
  "action": {
    "default_title": "Quirra"
  }
}

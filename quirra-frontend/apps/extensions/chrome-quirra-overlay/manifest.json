{
  "manifest_version": 3,
  "name": "Quirra",
  "short_name": "Quirra",
  "version": "0.1.0",
  "description": "Non-blocking overlay that provides prompt/response analysis and suggestions.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "Quirra Overlay"
  }
}

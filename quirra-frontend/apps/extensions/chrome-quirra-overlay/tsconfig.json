{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["es2020", "dom"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "rootDir": "src",
    "outDir": "build",

    "strict": true,
    "skipLibCheck": true,
    "types": ["chrome"],

    "noEmit": false,        
    "declaration": false,
    "sourceMap": false
  },
  "include": ["src/**/*.ts"]
}
